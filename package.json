{
  "name": "oniroute",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "npm run typecheck:web && npm run typecheck:functions",
    "typecheck:web": "tsc -b",
    "typecheck:functions": "deno check --allow-import --config supabase/functions/deno.json supabase/functions/api/index.ts supabase/functions/embed-knowledge/index.ts",
    "lint:functions": "deno lint --config supabase/functions/deno.json supabase/functions",
    "verify": "npm run typecheck && npm run lint && npm run lint:functions",
    "setup": "bash scripts/setup.sh",
    "setup:local": "bash scripts/setup.sh --local",
    "supabase:start": "npx -y supabase@2.109.1 start",
    "supabase:stop": "npx -y supabase@2.109.1 stop",
    "local": "node server/index.mjs",
    "server:local": "node server/index.mjs",
    "test:local": "node scripts/test-local-server.mjs",
    "seed": "node scripts/seed-knowledge.mjs --ingest",
    "seed:check": "node scripts/seed-knowledge.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "hono": "^4.0.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "deno": "^2.9.4",
    "eslint": "^9.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.0"
  }
}
