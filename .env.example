# =============================================================================
# OniRoute Environment Configuration
# =============================================================================

# --- OPTION A: Local Supabase (100% Free / Docker) ---
# When running `npm run setup:local` or `npx supabase start`, use these local values:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM0NTk5NDl9.dummy

# --- OPTION B: Supabase Cloud ---
# Replace with your project URL and publishable/anon key from app.supabase.com:
VITE_SUPABASE_URL=https://skbbzlwzsarmideehvmz.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# --- Seed Script Credentials (Optional, for npm run seed) ---
# A dashboard account used to create knowledge bases and trigger ingestion.
# ONIROUTE_EMAIL=admin@example.com
# ONIROUTE_PASSWORD=your-password
#
# Optional: a GitHub personal access token raises the API limit from 60 to
# 5,000 requests/hour, which makes repository ingestion reliable.
# GITHUB_TOKEN=ghp_your_github_token
#
# Optional: the UUID of the embedding provider to use for seeding. If omitted,
# the first provider with an embedding model is used.
# ONIROUTE_EMBEDDING_PROVIDER=
